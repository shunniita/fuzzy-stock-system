{
  "name": "fuzzy-stock-system",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "release:package": "node scripts/package-release.mjs",
    "release:check": "node scripts/test-release-package.mjs",
    "release:smoke": "node scripts/verify-release.mjs",
    "performance:measure": "npm run build && node scripts/measure-local-performance.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
